{
  "netlist": "diff_pair_diff.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt",
      "ss",
      "ff"
    ],
    "supply_v": {
      "vdd": [
        1.62,
        1.98
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "ac",
    "args": "dec 5 1 100meg"
  },
  "measurements": [
    {
      "name": "diff_gain_db",
      "spice": ".meas ac diff_gain_db FIND vdb(dout) AT=1k",
      "unit": "dB",
      "limits": {
        "min": 8
      }
    }
  ],
  "options": {
    "timeout_s": 120,
    "keep_artifacts": false,
    "max_workers": 4
  },
  "backend": "local-parallel"
}
