{
  "netlist": "diff_pair_cm.spice",
  "engine": "ngspice",
  "models": { "lib": "models.lib" },
  "corners": {
    "process": ["tt", "ss", "ff"],
    "supply_v": { "vdd": [1.62, 1.98] },
    "temperature_c": [-40, 27, 125]
  },
  "analysis": { "kind": "ac", "args": "dec 5 1 100meg" },
  "measurements": [
    {
      "name": "cm_out_db",
      "spice": ".meas ac cm_out_db FIND vdb(dout) AT=1k",
      "unit": "dB",
      "limits": { "max": 0 }
    }
  ],
  "options": { "timeout_s": 30, "keep_artifacts": false }
}
