{
  "name": "klayout-tools-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite + React static site for the klayout-tools.org gallery (Epic #13, migrated from Astro to Vite/React/Tailwind/shadcn in #92).",
  "scripts": {
    "copy-renders": "node scripts/copy-renders.mjs",
    "predev": "npm run copy-renders",
    "dev": "vite",
    "prebuild": "npm run copy-renders",
    "build": "tsc -b && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
