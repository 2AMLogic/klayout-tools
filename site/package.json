{
  "name": "klayout-tools-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite + React static site for the klayout-tools.org gallery (Epic #13, migrated from Astro to Vite/React/Tailwind/shadcn in #92).",
  "scripts": {
    "copy-renders": "node scripts/copy-renders.mjs",
    "stage-models": "node scripts/stage-models.mjs",
    "stage-em-data": "node scripts/stage-em-data.mjs",
    "predev": "npm run copy-renders && npm run stage-models && npm run stage-em-data",
    "dev": "vite",
    "prebuild": "npm run copy-renders && npm run stage-models && npm run stage-em-data",
    "build": "tsc -b && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "vitest run",
    "playground-perf": "node scripts/playground-perf.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eecircuit-engine": "1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
