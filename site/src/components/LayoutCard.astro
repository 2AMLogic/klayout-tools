---
/**
 * LayoutCard — one gallery card per discovered block (issue #63, mirroring
 * kicad-tools#3680/#3683's BoardCard).
 *
 * Renders a thumbnail (first `renders` entry, falling back to a static
 * placeholder), the block `name` + `description`, a status chip driven by
 * `Layout.status`, and a set of metric badges. Every optional field follows
 * the data contract's omit-when-absent rule: a badge is rendered only when
 * its backing field is `!== undefined`, never as "null" or "—" (see
 * `src/data/types.ts`).
 *
 * The whole card links to `/<slug>` — the per-block detail route built in
 * issue #64. Until that page exists the link 404s, which is expected.
 */
import type { Layout, LayoutStatus } from "../data/types.ts";

interface Props {
  layout: Layout;
}

const { layout } = Astro.props;

/**
 * `status: "ok"` means "metrics parsed cleanly" — a data-quality statement,
 * not a claim about the block itself, so a healthy card gets no chip at
 * all. Only degraded states are called out.
 */
const STATUS_LABEL: Partial<Record<LayoutStatus, string>> = {
  partial: "Partial artifacts",
  no_artifacts: "No artifacts",
};

/**
 * Resolve the thumbnail URL. `layout.renders` maps a render id to a path
 * relative to the block's `output/` directory (e.g. `"renders/1_0.png"`,
 * per `docs/cli/layout-metrics.md`); the `copy-renders` prebuild step
 * stages that same tree at `site/public/blocks/<slug>/`, so the value can
 * be appended to `/blocks/<slug>/` verbatim.
 */
function thumbnailFor(l: Layout): { src: string; isPlaceholder: boolean } {
  const renders = l.renders;
  // Prefer the all-layers composite (`klt render`'s overview.png) — a
  // single-layer render makes a poor "what is this block" thumbnail.
  const entry = renders ? (renders["overview"] ?? Object.values(renders)[0]) : undefined;
  if (entry) {
    const rel = entry.replace(/^\.?\//, "");
    return { src: `/blocks/${l.slug}/${rel}`, isPlaceholder: false };
  }
  return { src: "/placeholder-layout.svg", isPlaceholder: true };
}

const thumb = thumbnailFor(layout);
const displayName = layout.name || layout.slug;
const href = `/${layout.slug}`;
const statusLabel = STATUS_LABEL[layout.status];
---

<a class="card" href={href} data-status={layout.status}>
  <div class="thumb">
    <img
      src={thumb.src}
      alt={thumb.isPlaceholder
        ? `No render available for ${displayName}`
        : `Render of ${displayName}`}
      loading="lazy"
      decoding="async"
      class:list={["thumb-img", { "is-placeholder": thumb.isPlaceholder }]}
    />
    {statusLabel && <span class:list={["chip", `chip-${layout.status}`]}>{statusLabel}</span>}
  </div>

  <div class="body">
    <h2 class="name">{displayName}</h2>
    {layout.description && <p class="desc">{layout.description}</p>}

    <ul class="badges">
      {
        layout.layer_count !== undefined && (
          <li class="badge">
            <span class="badge-label">Layers</span>
            <span class="badge-value">{layout.layer_count}</span>
          </li>
        )
      }
      {
        layout.cell_count !== undefined && (
          <li class="badge">
            <span class="badge-label">Cells</span>
            <span class="badge-value">{layout.cell_count}</span>
          </li>
        )
      }
      {
        layout.instance_count !== undefined && (
          <li class="badge">
            <span class="badge-label">Instances</span>
            <span class="badge-value">{layout.instance_count}</span>
          </li>
        )
      }
      {
        layout.drc !== undefined && (
          <li class:list={["badge", { "badge-warn": layout.drc.violation_count > 0 }]}>
            <span class="badge-label">DRC</span>
            <span class="badge-value">
              {layout.drc.status === "clean"
                ? "clean"
                : `${layout.drc.violation_count} violation${layout.drc.violation_count === 1 ? "" : "s"}`}
            </span>
          </li>
        )
      }
    </ul>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border, #232a36);
    border-radius: 12px;
    background: var(--panel, #161b24);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--cyan, #3ee0e8);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    outline: none;
  }

  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #0b0e13;
    overflow: hidden;
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .thumb-img.is-placeholder {
    object-fit: cover;
  }

  .chip {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    backdrop-filter: blur(4px);
  }

  .chip-partial {
    background: rgb(255 160 40 / 0.9);
    color: #1a1300;
  }

  .chip-no_artifacts {
    background: rgb(141 151 165 / 0.85);
    color: #0c1116;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 1rem 1.1rem;
  }

  .name {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.05rem;
    line-height: 1.25;
    word-break: break-word;
    color: var(--fog, #c6cdd6);
  }

  .desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--fog-dim, #8d97a5);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .badges {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid var(--border, #232a36);
    font-size: 0.74rem;
  }

  .badge-warn {
    border-color: rgb(255 160 40 / 0.6);
    background: rgb(255 160 40 / 0.12);
  }

  .badge-label {
    color: var(--fog-dim, #8d97a5);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.64rem;
  }

  .badge-value {
    font-weight: 600;
    color: var(--fog, #c6cdd6);
  }
</style>
