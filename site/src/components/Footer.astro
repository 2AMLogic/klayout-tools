---
/**
 * Footer — shared site chrome for the klayout-tools.org gallery (issue #66).
 *
 * Rendered at the bottom of every page via `Layout.astro`. Carries
 * provenance: the build-time short git commit hash (linked to the commit on
 * GitHub when resolvable), a copyright line, and a link to the project's own
 * scope doc (`docs/ARCHITECTURE.md`) — no KiCad-style trademark disclaimer
 * applies here, since klayout-tools is an original 2AM Logic project rather
 * than a community fork of someone else's trademark (see issue #66).
 *
 * The commit-hash lookup (`getBuildSha`, `site/src/data/buildInfo.ts`) has
 * a graceful "unknown"/`$GITHUB_SHA` fallback so this component never
 * breaks `npm run build` outside a git checkout.
 */
import { commitUrl, getBuildSha } from "../data/buildInfo.ts";

const REPO_URL = "https://github.com/2AMLogic/klayout-tools";

const build = getBuildSha();
const url = commitUrl(REPO_URL, build);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="line">
    Build:
    <a href={url} target="_blank" rel="noopener noreferrer">
      <code>{build.sha}</code>
    </a>
  </p>
  <p class="line">© {year} 2AM Logic / klayout-tools contributors</p>
  <p class="line">
    <a
      href="https://github.com/2AMLogic/klayout-tools/blob/main/docs/ARCHITECTURE.md"
      target="_blank"
      rel="noopener noreferrer"
    >
      Project scope &amp; architecture
    </a>
  </p>
</footer>

<style>
  .site-footer {
    max-width: 44rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 2rem;
    width: 100%;
    border-top: 1px solid var(--border);
    color: var(--fog-dim);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .line {
    margin: 0.3rem 0;
  }

  .site-footer a {
    color: var(--fog-dim);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--cyan);
    outline: none;
  }

  .site-footer code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
</style>
