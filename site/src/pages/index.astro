---
// klayout-tools.org landing page.
//
// Scope: fold in the closed-loop vision statement + roadmap / architecture
// links from issue #11 (verbatim, mirroring site/index.html — landed in
// #59), and render the gallery index — one card per block discovered by the
// build-time layout data loader (issue #63, mirroring kicad-tools#3680/
// #3683). Each card links to its `/<slug>` detail page (#64).
//
// Site chrome (issue #66): the `<html>`/`<head>` boilerplate plus the shared
// header/footer come from `Layout.astro`, which this page renders through
// rather than owning its own document shell. Only the page-specific `<main>`
// content and its scoped styles live here.
import Layout from "../layouts/Layout.astro";
import { loadLayouts } from "../data/loadLayouts.ts";
import LayoutCard from "../components/LayoutCard.astro";

const layouts = loadLayouts();
const withData = layouts.filter((l) => l.status !== "no_artifacts").length;
---

<Layout
  title="klayout-tools — IC layout for AI agents"
  description="Standalone tools that let AI agents parse, check, and edit chip layouts. The kicad-tools playbook, one layer down the stack. In progress, in the open."
>
  <main>
    <h1>klayout-tools</h1>
    <p class="tag">IC layout for AI agents</p>
    <span class="status">scaffold — in progress, in the open</span>

    <p style="margin-top:2rem">
      Standalone tools that let AI agents parse, check, and edit chip layouts:
      GDSII and OASIS streams, DRC decks, headless everything, machine-readable
      JSON everywhere. Built on <a href="https://www.klayout.de">KLayout</a>'s
      Python API.
    </p>
    <p>
      It is the <a href="https://kicad-tools.org">kicad-tools</a> playbook one
      layer down the stack. Over there, agents take a design from schematic to
      routed PCB to fabrication package, and a gallery of real boards proves it.
      Here, the same pattern meets silicon.
    </p>
    <p>
      An agent can take a spec → schematic/generator → sized circuit → layout
      → DRC/LVS clean → extracted netlist → simulation-verified, on an open
      PDK, unaided — with every step headless and JSON-contracted. That
      closed loop is the target.
    </p>

    <pre><span class="c"># the interface contract we are building toward</span>
klt layers design.gds              <span class="c"># enumerate layers, JSON out</span>
klt cells design.gds --top         <span class="c"># cell hierarchy</span>
klt drc design.gds --deck sky130   <span class="c"># DRC, structured violations</span>
klt stats design.gds --per-layer   <span class="c"># densities, bbox, counts</span></pre>

    <p class="dim">
      Progress lands in the repo first; worked examples appear here the
      way boards appear in the kicad-tools gallery. See the
      <a href="https://github.com/2AMLogic/klayout-tools/blob/main/ROADMAP.md">roadmap</a>
      for the build order and the
      <a href="https://github.com/2AMLogic/klayout-tools/blob/main/docs/ARCHITECTURE.md">architecture</a>
      doc for how the pieces fit.
    </p>

    <h2>Gallery</h2>
    <p class="dim">
      Blocks discovered by the build-time layout data loader
      (<code>src/data/loadLayouts.ts</code>), each rendered from its
      <code>klt layout-metrics</code> output.
    </p>
    <p class="count">
      {layouts.length} block{layouts.length === 1 ? "" : "s"}
      {withData > 0 && ` · ${withData} with generated artifacts`}
    </p>

    {layouts.length === 0 && (
      <p class="dim">
        No blocks discovered. Add blocks under <code>blocks/</code> and run
        <code>klt layout-metrics</code> to populate data.
      </p>
    )}

    <ul class="grid" role="list">
      {
        layouts.map((layout) => (
          <li>
            <LayoutCard layout={layout} />
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  /*
   * Page-scoped styles only. The dark-theme CSS variables (`--night`,
   * `--orange`, …), the `body` reset/flex column, and the base `a` styling
   * are declared once in `Layout.astro`'s global style block; the header and
   * footer own their own chrome. The gallery grid widens `main` past the
   * 44rem prose column while the prose/pre blocks stay capped for readability.
   */
  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    flex: 1;
  }
  main > p,
  main > pre {
    max-width: 44rem;
  }
  h1 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 2.2rem;
    color: var(--orange);
    text-shadow:
      0 0 6px rgb(255 160 40 / 0.9),
      0 0 24px rgb(255 160 40 / 0.4);
  }
  h2 {
    margin-top: 2.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.3rem;
    color: var(--cyan);
  }
  .tag {
    margin-top: 0.5rem;
    color: var(--cyan);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-size: 0.85rem;
    text-shadow:
      0 0 6px rgb(62 224 232 / 0.8),
      0 0 20px rgb(62 224 232 / 0.3);
  }
  p {
    margin: 1.1rem 0;
    line-height: 1.7;
  }
  .dim {
    color: var(--fog-dim);
  }
  pre {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--fog);
  }
  pre .c {
    color: var(--fog-dim);
  }
  .status {
    display: inline-block;
    margin-top: 1.2rem;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--orange);
    border-radius: 999px;
    color: var(--orange);
    font-size: 0.8rem;
  }
  .count {
    color: var(--fog-dim);
    font-size: 0.85rem;
  }
  .grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .grid > li {
    display: flex;
  }
  .grid > li > :global(.card) {
    width: 100%;
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
