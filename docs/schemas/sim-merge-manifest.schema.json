{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "klt sim-merge shard manifest",
  "type": "object",
  "required": ["schema_version", "shards"],
  "properties": {
    "schema_version": { "const": 1 },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "corners"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "request": { "type": "string" },
          "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "corners": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "dependentRequired": { "request_sha256": ["request"] }
      }
    }
  }
}
