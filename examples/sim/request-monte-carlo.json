{
  "netlist": "testbench-mc.spice",
  "engine": "ngspice",
  "models": {
    "lib": "corner.lib"
  },
  "corners": {
    "process": [
      "tt"
    ]
  },
  "monte_carlo": {
    "n": 20,
    "seed": 20260801,
    "vary": "mismatch",
    "quantiles": [
      5,
      50,
      95
    ],
    "k_sigma": 3
  },
  "analysis": {
    "kind": "tran",
    "args": "1n 5u"
  },
  "measurements": [
    {
      "name": "vout",
      "spice": ".meas tran vout FIND v(out) AT=5u",
      "unit": "V",
      "limits": {
        "min": 0.75,
        "max": 1.05
      }
    }
  ],
  "options": {
    "timeout_s": 30,
    "keep_artifacts": false
  }
}
