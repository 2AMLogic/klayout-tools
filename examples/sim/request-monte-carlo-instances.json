{
  "netlist": "testbench-mc-instances.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A"
  },
  "corners": {
    "process": [
      "tt_mm"
    ]
  },
  "monte_carlo": {
    "n": 50,
    "seed": 20261015,
    "vary": "mismatch",
    "instances": {
      "include": [
        "xm1",
        "xm2"
      ]
    }
  },
  "analysis": {
    "kind": "op"
  },
  "measurements": [
    {
      "name": "vdiff",
      "spice": ".meas op vdiff PARAM='v(d1)-v(d2)'",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 60,
    "keep_artifacts": false
  }
}
