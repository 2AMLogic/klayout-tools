{
  "netlist": "testbench-mc-instances.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt_mm"
    ]
  },
  "monte_carlo": {
    "n": 50,
    "seed": 20261015,
    "vary": "mismatch",
    "instances": {
      "include": [
        "xm1",
        "xm2"
      ]
    }
  },
  "analysis": {
    "kind": "op",
    "args": ""
  },
  "measurements": [
    {
      "name": "vdiff",
      "expr": "v(d1)-v(d2)",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 180,
    "keep_artifacts": false
  }
}
