.ic v(r1_5)=0 v(r2_5)=1.8 v(r3_5)=0 v(r4_5)=1.8 v(r5_5)=0
.ic v(r1_7)=0 v(r2_7)=1.8 v(r3_7)=0 v(r4_7)=1.8 v(r5_7)=0 v(r6_7)=1.8 v(r7_7)=0
.ic v(r1_9)=0 v(r2_9)=1.8 v(r3_9)=0 v(r4_9)=1.8 v(r5_9)=0 v(r6_9)=1.8 v(r7_9)=0 v(r8_9)=1.8 v(r9_9)=0

* ============================================================
* XOR TREE: xor_ab = ring5 XOR ring7 ; xor_out = xor_ab XOR ring9
* XOR2(a,b,y): b_bar = NOT b; TG_hi passes b when a=1; TG_lo passes b_bar
* when a=0. y = a?b:NOT(b) = a XOR b.
* ============================================================

* --- b_bar for stage 1 (b = r1_7) ---
XBB1P bbar1 r1_7 vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XBB1N bbar1 r1_7 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
* --- a_bar for stage 1 (a = r1_5) ---
XAB1P abar1 r1_5 vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XAB1N abar1 r1_5 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
* --- TG_hi: passes r1_7 to xor_ab when r1_5=1 ---
XTGHI1N r1_7 r1_5 xor_ab 0   sky130_fd_pr__nfet_01v8 L={ltg} W={wtg} nf=1 mult=1
XTGHI1P r1_7 abar1 xor_ab vdd sky130_fd_pr__pfet_01v8 L={ltg} W={wtg} nf=1 mult=1
* --- TG_lo: passes bbar1 to xor_ab when r1_5=0 ---
XTGLO1N bbar1 abar1 xor_ab 0   sky130_fd_pr__nfet_01v8 L={ltg} W={wtg} nf=1 mult=1
XTGLO1P bbar1 r1_5 xor_ab vdd sky130_fd_pr__pfet_01v8 L={ltg} W={wtg} nf=1 mult=1

* --- b_bar for stage 2 (b = r1_9) ---
XBB2P bbar2 r1_9 vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XBB2N bbar2 r1_9 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
* --- a_bar for stage 2 (a = xor_ab) ---
XAB2P abar2 xor_ab vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XAB2N abar2 xor_ab 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
* --- TG_hi: passes r1_9 to xor_out when xor_ab=1 ---
XTGHI2N r1_9 xor_ab xor_out 0   sky130_fd_pr__nfet_01v8 L={ltg} W={wtg} nf=1 mult=1
XTGHI2P r1_9 abar2  xor_out vdd sky130_fd_pr__pfet_01v8 L={ltg} W={wtg} nf=1 mult=1
* --- TG_lo: passes bbar2 to xor_out when xor_ab=0 ---
XTGLO2N bbar2 abar2 xor_out 0   sky130_fd_pr__nfet_01v8 L={ltg} W={wtg} nf=1 mult=1
XTGLO2P bbar2 xor_ab xor_out vdd sky130_fd_pr__pfet_01v8 L={ltg} W={wtg} nf=1 mult=1

* ============================================================
* SAMPLER (identical construction to ring-oscillator-jitter-trng's; see
* that netlist's header for the design rationale). Samples xor_out.
* ============================================================
Vsmp smp 0 PULSE(0 1.8 5n 50p 50p 200p 11n)

XSMBP smp_b smp vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XSMBN smp_b smp 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1

XTGN xor_out smp   samp 0   sky130_fd_pr__nfet_01v8 L={ltg} W={wtg} nf=1 mult=1
XTGP xor_out smp_b samp vdd sky130_fd_pr__pfet_01v8 L={ltg} W={wtg} nf=1 mult=1

XHAP y_b samp vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XHAN y_b samp 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
XHBP y y_b vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XHBN y y_b 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1

XFBN y smp_b samp 0   sky130_fd_pr__nfet_01v8 L={ltgfb} W={wtgfb} nf=1 mult=1
XFBP y smp   samp vdd sky130_fd_pr__pfet_01v8 L={ltgfb} W={wtgfb} nf=1 mult=1
