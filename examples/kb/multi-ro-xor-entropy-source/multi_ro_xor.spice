XIP2_7 r2_7 r1_7 vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XIN2_7 r2_7 r1_7 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
C2_7 r2_7 0 {cload}
XIP3_7 r3_7 r2_7 vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XIN3_7 r3_7 r2_7 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
