* --- ring9 (9-stage) ---
XIP1_9 r1_9 r9_9 vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
XIN1_9 r1_9 r9_9 0   0   sky130_fd_pr__nfet_01v8 L={l} W={wn} nf=1 mult=1
C1_9 r1_9 0 {cload}
XIP2_9 r2_9 r1_9 vdd vdd sky130_fd_pr__pfet_01v8 L={l} W={wp} nf=1 mult=1
