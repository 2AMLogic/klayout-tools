{
  "netlist": "sram_cell_powerup.spice",
  "engine": "ngspice",
  "models": { "pdk": "sky130A", "lib": "libs.tech/ngspice/sky130.lib.spice" },
  "corners": {
    "process": ["tt"],
    "temperature_c": [27]
  },
  "analysis": { "kind": "tran", "args": "20p 200n" },
  "measurements": [
    { "name": "vq_final_v", "spice": ".meas tran vq_final_v find v(q) at=190n", "unit": "V", "limits": { "min": 1.7 } },
    { "name": "vqb_final_v", "spice": ".meas tran vqb_final_v find v(qb) at=190n", "unit": "V", "limits": { "max": 0.1 } },
    { "name": "t_resolve_s", "spice": ".meas tran t_resolve_s when v(q)=0.9 rise=1", "unit": "s", "limits": { "max": 1e-7 } },
    { "name": "vdd_at_resolve_v", "spice": ".meas tran vdd_at_resolve_v find v(vddc) when v(q)=0.9 rise=1", "unit": "V", "limits": { "max": 1.8 } },
    { "name": "vq_50n", "spice": ".meas tran vq_50n find v(q) at=50n", "unit": "V" },
    { "name": "vqb_50n", "spice": ".meas tran vqb_50n find v(qb) at=50n", "unit": "V" },
    { "name": "vsep_50n_v", "spice": ".meas tran vsep_50n_v param='vq_50n - vqb_50n'", "unit": "V", "limits": { "min": 0 } }
  ],
  "options": { "timeout_s": 600, "keep_artifacts": false }
}
